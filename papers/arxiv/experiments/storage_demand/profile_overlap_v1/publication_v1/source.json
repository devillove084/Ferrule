        "        let result = reader",
        "            .verified_read_session(ticket.read_plan())",
        "            .and_then(|session| {",
        "                #[cfg(test)]",
        "                call_hook(hook, TestPhase::SessionOpened, &mut ticket.clone());",
        "                session.read_incrementally(|session| {",
        "                    receipt.io_started_at = Some(Instant::now());",
        "                    #[cfg(test)]",
        "                    call_hook(hook, TestPhase::IoStarted, &mut ticket.clone());",
        "                    let result = {",
        "                        // Actual worker allocation/pread envelope, excluding",
        "                        // session opening and pre/post source verification.",
        "                        let _range = tracing::debug_span!(target: \"ferrule_profile\", \"read_subset\",",
        "                            operation = ticket.operation.get(),",
        "                            source_generation = ticket.source_generation.get(),",
        "                            requested_bytes = ticket.read_plan().storage_bytes())",
        "                        .entered();",
        "                        session.read_subset(ticket.read_plan())",
        "                    };",
        "                    receipt.io_finished_at = Some(Instant::now());",
        "                    if let Ok(bytes) = &result {",
        "                        receipt.io_bytes = Some(bytes.len() as u64);",
        "                    }",
        "                    #[cfg(test)]",
        "                    call_hook(hook, TestPhase::PayloadRead, &mut ticket.clone());",
        "                    result",
        "                })",
        "            });",
        "        match result {",
        "            Ok(bytes) => {",
        "                receipt.source_verified_at = Some(Instant::now());",
        "                receipt.payload_bytes = bytes.len() as u64;",
        "                ReadOutcome::SourceVerified(bytes)",
        "            }",
        "            Err(error) => ReadOutcome::Failed(error),",
        "        }"
      ],
      "source_member": "crates/ferrule-model/src/checkpoint/read_pipeline.rs",
      "whole_file_sha256": "bd9a3bf2e8545798ecda4f7734da2eeea724a564bd416bcdb29298cc86100493"
    },
    {
      "first_line": 98,
      "last_line": 135,
      "lines": [
        "",
        "    fn read_exact_at(&self, mut bytes: &mut [u8], mut offset: u64) -> io::Result<()> {",
        "        #[cfg(not(unix))]",
        "        use std::io::{Read, Seek, SeekFrom};",
        "        #[cfg(unix)]",
        "        use std::os::unix::fs::FileExt;",
        "        #[cfg(not(unix))]",
        "        let mut file = self",
        "            .file",
        "            .lock()",
        "            .map_err(|_| io::Error::other(\"checkpoint file lock poisoned\"))?;",
        "        #[cfg(not(unix))]",
        "        file.seek(SeekFrom::Start(offset))?;",
        "        while !bytes.is_empty() {",
        "            self.counters.read_calls.fetch_add(1, Ordering::Relaxed);",
        "            #[cfg(unix)]",
        "            let result = self.file.read_at(bytes, offset);",
        "            #[cfg(not(unix))]",
        "            let result = file.read(bytes);",
        "            match result {",
        "                Ok(0) => {",
        "                    return Err(io::Error::new(",
        "                        io::ErrorKind::UnexpectedEof,",
        "                        \"checkpoint source truncated\",",
        "                    ));",
        "                }",
        "                Ok(count) => {",
        "                    self.counters",
        "                        .bytes_read",
        "                        .fetch_add(count as u64, Ordering::Relaxed);",
        "                    offset += count as u64;",
        "                    bytes = &mut bytes[count..];",
        "                }",
        "                Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,",
        "                Err(error) => return Err(error),",
        "            }",
        "        }",
        "        Ok(())"
      ],
      "source_member": "crates/ferrule-model/src/checkpoint/read_session.rs",
      "whole_file_sha256": "100313f44b1d08fab0505c201d295df309fecdbb5847e0ec4db7390011bc6600"
    },
    {
      "first_line": 316,
      "last_line": 355,
      "lines": [
        "    /// The callback must join all workers before returning. Nothing escapes the",
        "    /// transaction until the unique-source post boundary succeeds.",
        "    pub(crate) fn read_incrementally<T>(self, read: impl FnOnce(&Self) -> Result<T>) -> Result<T> {",
        "        let result = read(&self)?;",
        "        self.validate_boundary()?;",
        "        Ok(result)",
        "    }",
        "",
        "    pub(crate) fn read_subset(&self, plan: &CheckpointReadPlan) -> Result<Vec<u8>> {",
        "        if plan",
        "            .source_files()",
        "            .iter()",
        "            .any(|s| !self.plan.source_files().contains(s))",
        "            || plan.extents().iter().any(|e| {",
        "                !self",
        "                    .extents",
        "                    .contains(&(e.path().to_path_buf(), e.offset(), e.bytes()))",
        "            })",
        "        {",
        "            return Err(invalid(\"incremental read is outside the verified session\"));",
        "        }",
        "        let length = plan.storage_bytes() as usize;",
        "        let mut bytes = Vec::new();",
        "        bytes",
        "            .try_reserve_exact(length)",
        "            .map_err(|error| invalid(format!(\"allocate batch: {error}\")))?;",
        "        bytes.resize(length, 0);",
        "        let mut cursor = 0;",
        "        for extent in plan.extents() {",
        "            let end = cursor + extent.bytes() as usize;",
        "            self.handles[extent.path()]",
        "                .read_exact_at(&mut bytes[cursor..end], extent.offset())",
        "                .map_err(|error| {",
        "                    invalid(format!(",
        "                        \"read '{}' extent {}..{}: {error}\",",
        "                        extent.path().display(),",
        "                        extent.offset(),",
        "                        extent.end()",
        "                    ))",
        "                })?;"
      ],
      "source_member": "crates/ferrule-model/src/checkpoint/read_session.rs",
      "whole_file_sha256": "100313f44b1d08fab0505c201d295df309fecdbb5847e0ec4db7390011bc6600"
    }
  ],
